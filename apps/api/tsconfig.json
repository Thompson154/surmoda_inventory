{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@surmoda/contracts": ["../../packages/contracts/src/index.ts"],
      "@surmoda/contracts/*": ["../../packages/contracts/src/*"]
    },
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "isolatedModules": false,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["src/**/*", "prisma/seed.ts", "tests/**/*", "jest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
