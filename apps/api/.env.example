# ─────────────────────────────────────────────────────────────────────────────
# Sur Moda API — environment template.
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every key here is validated at boot by `infrastructure/config.ts` (zod);
# missing or malformed values fail-fast with a structured error.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# Matches the docker container `pg-degrado` (postgres:15) used by the
# `npm run dev:db` helper in the README.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proyectodegrado
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/proyectodegrado_test

# ── JWT ──────────────────────────────────────────────────────────────────────
# Replace with a per-environment secret. Re-generate with:
#   openssl rand -hex 32
# Must be ≥32 chars or boot fails.
JWT_SECRET=replace-me-with-a-random-64-char-hex-string

# ── Cookie / CORS ────────────────────────────────────────────────────────────
# COOKIE_DOMAIN sets the domain on the refresh-token cookie. In dev keep
# `localhost`; in prod set to the apex (e.g. `surmoda.com`) so subdomains
# share auth. FE_ORIGIN is whitelisted by the CORS middleware.
COOKIE_DOMAIN=localhost
FE_ORIGIN=http://localhost:5173

# ── Token TTLs ───────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Crypto ───────────────────────────────────────────────────────────────────
# Bcrypt rounds. 12 is the production minimum (~250ms per hash on a modern
# CPU). Tests override to 4 via test/setupEnv for speed.
BCRYPT_SALT_ROUNDS=12

# ── Rate limits (per IP per minute) ──────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REFRESH_PER_MIN=30

# ── Logging ──────────────────────────────────────────────────────────────────
# pino levels. info in prod, debug to chase a bug, silent in CI.
LOG_LEVEL=info

# ── Feature flags ────────────────────────────────────────────────────────────
# Feature 012 — when "true" the dailyLock cron locks branch sales at 22:00
# Bolivia and clears the lock at 00:00. Default off so ops can flip without
# a redeploy. Accepts "true" or "1"; anything else evaluates to false.
ENABLE_DAILY_SALES_LOCK=false

# ── Image storage ────────────────────────────────────────────────────────────
# local      → files under IMAGE_STORAGE_LOCAL_DIR (default <repo>/imagesTest)
#              served by the API at /static/images. Convenient for dev.
# cloudinary → uploads via Cloudinary SDK. The three CLOUDINARY_* keys are
#              REQUIRED in this mode; boot fails if any is missing.
IMAGE_STORAGE=local
IMAGE_STORAGE_LOCAL_DIR=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
