NODE_ENV=development
PORT=3000

# Database — matches the docker container `pg-degrado` (postgres:15)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proyectodegrado
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/proyectodegrado_test

# JWT — replace with the secret generated for this machine.
# Re-generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-64-char-hex-string

# Cookie / CORS
COOKIE_DOMAIN=localhost
FE_ORIGIN=http://localhost:5173

# Token TTLs
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Crypto
BCRYPT_SALT_ROUNDS=12

# Rate limits (per IP per window)
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REFRESH_PER_MIN=30

# Logging
LOG_LEVEL=info
