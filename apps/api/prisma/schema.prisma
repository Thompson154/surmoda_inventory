// Prisma schema — feature 001-auth-roles
// Conventions: PascalCase singular models, snake_case plural tables (@@map),
//              camelCase fields, snake_case columns (@map), `Json` for jsonb.
//
// See: specs/001-auth-roles/data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  encargada
  vendedora

  @@map("user_role")
}

enum StoreKind {
  warehouse
  branch

  @@map("store_kind")
}

enum Size {
  s
  m
  l
  xl
  xxl
  size_28  @map("28")
  size_30  @map("30")
  size_32  @map("32")
  size_34  @map("34")
  standard

  @@map("variant_size")
}

enum StockMovementType {
  adjusted
  edit_permission_toggled

  @@map("stock_movement_type")
}

model Store {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  kind      StoreKind
  isActive  Boolean   @default(true) @map("is_active")

  assignments UserStore[]
  stock          StockBySite[]
  movements      StockMovement[]
  editPermission StoreEditPermission?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([isActive, kind])
  @@map("stores")
}

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  variants Variant[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([isActive])
  @@map("products")
}

model Variant {
  id         String  @id @default(cuid())
  productId  String  @map("product_id")
  size       Size
  color      String
  barcode    String  @unique
  priceCents Int     @map("price_cents")
  imagePath  String? @map("image_path")
  isActive   Boolean @default(true) @map("is_active")

  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stock     StockBySite[]
  movements StockMovement[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([productId, size, color, deletedAt])
  @@index([productId, isActive])
  @@index([barcode])
  @@map("variants")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  isAdmin      Boolean   @default(false) @map("is_admin")
  isActive     Boolean   @default(true) @map("is_active")

  assignments      UserStore[]
  refreshTokens    RefreshToken[]
  stockMovements   StockMovement[]
  editPermissions  StoreEditPermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([email])
  @@index([isActive, isAdmin])
  @@map("users")
}

model UserStore {
  id      String @id @default(cuid())
  userId  String @map("user_id")
  storeId String @map("store_id")
  role    Role

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, storeId, deletedAt])
  @@index([userId])
  @@index([storeId])
  @@map("user_stores")
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  tokenHash     String    @unique @map("token_hash")
  parentTokenId String?   @map("parent_token_id")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  ip            String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   RefreshToken?  @relation("TokenFamily", fields: [parentTokenId], references: [id])
  children RefreshToken[] @relation("TokenFamily")

  @@index([userId, revokedAt, expiresAt])
  @@index([parentTokenId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   Json
  ip        String?
  userAgent String?  @map("user_agent")
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([entity, entityId])
  @@index([action, timestamp])
  @@map("audit_logs")
}

model StockBySite {
  id        String @id @default(cuid())
  variantId String @map("variant_id")
  storeId   String @map("store_id")
  quantity  Int    @default(0)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([variantId, storeId])
  @@index([storeId])
  @@map("stock_by_site")
}

model StockMovement {
  id        String            @id @default(cuid())
  storeId   String            @map("store_id")
  variantId String?           @map("variant_id")
  userId    String            @map("user_id")
  type      StockMovementType
  payload   Json              @default("{}")
  createdAt DateTime          @default(now()) @map("created_at")

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([storeId, createdAt])
  @@index([variantId])
  @@map("stock_movements")
}

model StoreEditPermission {
  storeId         String    @id @map("store_id")
  isEnabled       Boolean   @default(false) @map("is_enabled")
  toggledByUserId String?   @map("toggled_by_user_id")
  toggledAt       DateTime? @map("toggled_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user  User? @relation(fields: [toggledByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("store_edit_permission")
}
