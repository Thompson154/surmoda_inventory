// Prisma schema — feature 001-auth-roles
// Conventions: PascalCase singular models, snake_case plural tables (@@map),
//              camelCase fields, snake_case columns (@map), `Json` for jsonb.
//
// See: specs/001-auth-roles/data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  encargada
  vendedora

  @@map("user_role")
}

enum StoreKind {
  warehouse
  branch

  @@map("store_kind")
}

enum Size {
  s
  m
  l
  xl
  xxl
  size_28  @map("28")
  size_30  @map("30")
  size_32  @map("32")
  size_34  @map("34")
  standard

  @@map("variant_size")
}

enum StockMovementType {
  adjusted
  edit_permission_toggled
  delivery_in
  delivery_out
  /// Vendedora confirmed reception with a quantity lower (or higher) than the
  /// originally sent line. Always paired with a DeliveryItemAdjustment row.
  delivery_received_adjusted
  sale_out
  sale_return

  @@map("stock_movement_type")
}

enum DeliveryKind {
  reception
  distribution

  @@map("delivery_kind")
}

/// Lifecycle of a distribution-kind Delivery.
///   draft     → encargada is still composing the items, stock untouched
///   sent      → encargada confirmed; awaiting physical reception at the branch.
///                Stock still untouched at this stage.
///   received  → vendedora confirmed reception with the originally requested
///                quantities. Stock applied: -warehouse, +branch.
///   partial   → vendedora confirmed reception but adjusted at least one line's
///                quantity. Stock applied with the adjusted numbers. Original
///                vs. adjusted is recorded in DeliveryItemAdjustment for audit.
/// Reception-kind deliveries (warehouse intake from supplier) skip draft/sent
/// and live in `received` from creation.
enum DeliveryStatus {
  draft
  sent
  received
  partial

  @@map("delivery_status")
}

enum PaymentMethod {
  qr
  card
  cash

  @@map("payment_method")
}

model Store {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  kind      StoreKind
  isActive  Boolean   @default(true) @map("is_active")
  /// Feature 012 — daily sales lock. When non-null, /sales POST returns 423.
  /// Driven by the dailyLock cron (22:00 Bolivia set, 00:00 Bolivia clear).
  /// Field exists from 012; the cron only runs when env ENABLE_DAILY_SALES_LOCK
  /// is true so we can dark-launch the schema before flipping the behaviour.
  salesLockedAt DateTime? @map("sales_locked_at")

  assignments         UserStore[]
  stock               StockBySite[]
  movements           StockMovement[]
  editPermission      StoreEditPermission?
  deliveriesIn        Delivery[] @relation("DeliveryDest")
  deliveriesOut       Delivery[] @relation("DeliveryOrigin")
  sales               Sale[]
  dailyReports        DailyReport[]
  idempotencyKeys     IdempotencyKey[]
  inventorySnapshots  InventorySnapshot[]
  returnRequests      ReturnRequest[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([isActive, kind])
  @@map("stores")
}

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  variants Variant[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([isActive])
  @@map("products")
}

model Variant {
  id         String  @id @default(cuid())
  productId  String  @map("product_id")
  size       Size
  color      String
  barcode    String  @unique
  priceCents Int     @map("price_cents")
  imagePath  String? @map("image_path")
  isActive   Boolean @default(true) @map("is_active")

  product            Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stock              StockBySite[]
  movements          StockMovement[]
  deliveryItems      DeliveryItem[]
  saleItems          SaleItem[]
  inventorySnapshots InventorySnapshot[]
  returnRequestsAsReturned  ReturnRequest[] @relation("ReturnedVariantRequests")
  returnRequestsAsExchange  ReturnRequest[] @relation("ExchangeVariantRequests")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([productId, size, color, deletedAt])
  @@index([productId, isActive])
  @@index([barcode])
  @@map("variants")
}

model User {
  id           String    @id @default(cuid())
  /// `@unique` genera el índice simple `users_email_key` que Prisma usa para
  /// `findUnique({ where: { email } })` (auth/service.ts login). En paralelo,
  /// la migration 014 mantiene un índice funcional `users_email_lower_key`
  /// sobre `LOWER("email")` que enforcea uniqueness case-insensitive (defense-
  /// in-depth contra un import bulk que olvide lowercasear). La app además
  /// hace lowercasing al parsear con Zod, así que tenemos 3 capas. Ambos
  /// índices coexisten sin conflicto: el funcional es estrictamente más
  /// restrictivo que el simple.
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  isAdmin      Boolean   @default(false) @map("is_admin")
  isActive     Boolean   @default(true) @map("is_active")

  assignments       UserStore[]
  refreshTokens     RefreshToken[]
  stockMovements    StockMovement[]
  editPermissions   StoreEditPermission[]
  deliveriesCreated Delivery[]
  salesRecorded     Sale[]
  dailyReportsClosed DailyReport[]
  dailyReportAttendance DailyReportAttendance[]
  deliveriesReceived Delivery[]                 @relation("DeliveryReceiver")
  deliveryAdjustments DeliveryItemAdjustment[]
  returnRequestsCreated ReturnRequest[]         @relation("RequesterReturnRequests")
  returnRequestsReviewed ReturnRequest[]        @relation("ReviewerReturnRequests")
  deliveryEditRequestsCreated  DeliveryEditRequest[] @relation("RequesterDeliveryEditRequests")
  deliveryEditRequestsReviewed DeliveryEditRequest[] @relation("ReviewerDeliveryEditRequests")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([email])
  @@index([isActive, isAdmin])
  @@map("users")
}

model UserStore {
  id      String @id @default(cuid())
  userId  String @map("user_id")
  storeId String @map("store_id")
  role    Role

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, storeId, deletedAt])
  @@index([userId])
  @@index([storeId])
  @@map("user_stores")
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  tokenHash     String    @unique @map("token_hash")
  parentTokenId String?   @map("parent_token_id")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  ip            String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   RefreshToken?  @relation("TokenFamily", fields: [parentTokenId], references: [id])
  children RefreshToken[] @relation("TokenFamily")

  @@index([userId, revokedAt, expiresAt])
  @@index([parentTokenId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   Json
  ip        String?
  userAgent String?  @map("user_agent")
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([entity, entityId])
  @@index([action, timestamp])
  /// GIN sobre payload con jsonb_path_ops — habilita búsquedas tipo
  /// `payload @> '{"storeId":"..."}'` indexadas (Tier 3.B.1, migration 013).
  /// jsonb_path_ops es ~50% más chico y ~3x más rápido que jsonb_ops para
  /// el operador `@>`, que es el único que usamos para el audit log.
  @@index([payload(ops: JsonbPathOps)], type: Gin)
  @@map("audit_logs")
}

model StockBySite {
  id        String @id @default(cuid())
  variantId String @map("variant_id")
  storeId   String @map("store_id")
  quantity  Int    @default(0)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([variantId, storeId])
  @@index([storeId])
  @@index([storeId, variantId])
  @@map("stock_by_site")
}

model StockMovement {
  id        String            @id @default(cuid())
  storeId   String            @map("store_id")
  variantId String?           @map("variant_id")
  userId    String            @map("user_id")
  type      StockMovementType
  payload   Json              @default("{}")
  createdAt DateTime          @default(now()) @map("created_at")

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([storeId, createdAt])
  @@index([variantId])
  @@map("stock_movements")
}

model StoreEditPermission {
  storeId         String    @id @map("store_id")
  isEnabled       Boolean   @default(false) @map("is_enabled")
  toggledByUserId String?   @map("toggled_by_user_id")
  toggledAt       DateTime? @map("toggled_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user  User? @relation(fields: [toggledByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("store_edit_permission")
}

model Delivery {
  id               String         @id @default(cuid())
  /// Sequential, human-friendly id rendered as "EN-{n.padStart(4)}" on the FE.
  /// Postgres-managed sequence, globally unique across all kinds and stores.
  number           Int            @unique @default(autoincrement())
  kind             DeliveryKind
  /// Free-text label set by the encargada to identify the shipment
  /// ("Colección invierno", "Reposición urgente", etc.). Optional in `draft`,
  /// required to leave draft on distribution kind. Reception kind uses null.
  title            String?
  status           DeliveryStatus @default(received)
  fromStoreId      String?        @map("from_store_id")
  toStoreId        String         @map("to_store_id")
  createdByUserId  String         @map("created_by_user_id")
  /// Set when the encargada confirms the draft (draft → sent).
  sentAt           DateTime?      @map("sent_at")
  /// Set when the vendedora confirms reception (sent → received|partial).
  receivedAt       DateTime?      @map("received_at")
  receivedByUserId String?        @map("received_by_user_id")
  note             String?
  createdAt        DateTime       @default(now()) @map("created_at")
  /// La columna físicamente tiene DEFAULT now() (migration 011 agregó la
  /// columna NOT NULL a una tabla con datos pre-existentes). Documentamos el
  /// default explícitamente para que el schema sea fuente de verdad y no haya
  /// drift entre Prisma y la DB. `@updatedAt` sigue manejando el incremento.
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")

  fromStore   Store?                    @relation("DeliveryOrigin", fields: [fromStoreId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toStore     Store                     @relation("DeliveryDest", fields: [toStoreId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User                      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receivedBy  User?                     @relation("DeliveryReceiver", fields: [receivedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items       DeliveryItem[]
  adjustments DeliveryItemAdjustment[]
  editRequests DeliveryEditRequest[]

  @@index([status, toStoreId])
  @@index([toStoreId, createdAt])
  @@index([fromStoreId, createdAt])
  @@map("deliveries")
}

model DeliveryItem {
  id         String @id @default(cuid())
  deliveryId String @map("delivery_id")
  variantId  String @map("variant_id")
  /// Quantity sent by the encargada (== quantity at the moment of sent → received
  /// when no adjustment was made). Frozen once status leaves draft.
  quantity   Int
  /// Quantity actually confirmed at the destination. Equals `quantity` for
  /// non-adjusted lines. Differs only on `partial` deliveries; the diff is
  /// captured in DeliveryItemAdjustment for audit.
  receivedQuantity Int? @map("received_quantity")

  delivery    Delivery                  @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant     Variant                   @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  adjustments DeliveryItemAdjustment[]

  @@index([deliveryId])
  @@index([variantId])
  @@map("delivery_items")
}

/// Audit record of a vendedora adjusting a sent line at reception time. One
/// row per quantity change. Drives the anti-fraud signal: "vendedora X has
/// adjusted Y deliveries down by Z units this month".
model DeliveryItemAdjustment {
  id              String   @id @default(cuid())
  deliveryId      String   @map("delivery_id")
  deliveryItemId  String   @map("delivery_item_id")
  expectedQty     Int      @map("expected_qty")
  actualQty       Int      @map("actual_qty")
  reason          String?
  adjustedByUserId String  @map("adjusted_by_user_id")
  adjustedAt      DateTime @default(now()) @map("adjusted_at")

  delivery     Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveryItem DeliveryItem @relation(fields: [deliveryItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  adjustedBy   User         @relation(fields: [adjustedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([deliveryId])
  @@index([adjustedByUserId, adjustedAt])
  @@map("delivery_item_adjustments")
}

model Sale {
  id              String        @id @default(cuid())
  storeId         String        @map("store_id")
  recordedByUserId String       @map("recorded_by_user_id")
  paymentMethod   PaymentMethod @map("payment_method")
  totalCents      Int           @map("total_cents")
  createdAt       DateTime      @default(now()) @map("created_at")

  store Store      @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user  User       @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items SaleItem[]
  idempotencyKeys IdempotencyKey[]
  // WHY: reverse rel for ReturnRequest.originalSale FK (Wave 5 redesign).
  returnRequests  ReturnRequest[]

  @@index([storeId, createdAt])
  @@index([createdAt])
  @@map("sales")
}

/// Tier 3.A.3 — idempotency keys for POST /sales. The FE generates a UUID v4
/// per checkout attempt; the BE caches (store, key) → saleId for 24h. On
/// retry the cached saleId is returned, preventing duplicate sales when the
/// boutique wifi drops mid-request. Pruned by `idempotencyKeyCleanup` cron.
model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String
  storeId   String   @map("store_id")
  saleId    String   @map("sale_id")
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sale  Sale  @relation(fields: [saleId],  references: [id], onDelete: Cascade,  onUpdate: Cascade)

  @@unique([storeId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model SaleItem {
  id               String @id @default(cuid())
  saleId           String @map("sale_id")
  variantId        String @map("variant_id")
  quantity         Int
  priceAtSaleCents Int    @map("price_at_sale_cents")
  // WHY: dual-field model separates undiscounted total from charged amount for return and discount audit.
  /// Undiscounted line total (quantity × priceAtSaleCents). Frozen at charge time, never editable.
  totalCents       Int    @map("total_cents")
  /// Final amount charged for this line (in cents). Defaults to totalCents on creation;
  /// editable PRE-charge for discounts up to 30%. (totalCents - subtotalCents)/totalCents <= 0.30.
  subtotalCents    Int    @map("subtotal_cents")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

// Local-day midnight in Bolivia (UTC-4); used as the natural day key.
model DailyReport {
  id                 String   @id @default(cuid())
  storeId            String   @map("store_id")
  date               DateTime @db.Date
  totalCents         Int      @map("total_cents")
  qrCents            Int      @map("qr_cents")
  cardCents          Int      @map("card_cents")
  cashCents          Int      @map("cash_cents")
  itemCount          Int      @map("item_count")
  transactionsCount  Int      @map("transactions_count")
  closedByUserId     String?  @map("closed_by_user_id")
  closedAt           DateTime @map("closed_at")
  autoClosed         Boolean  @default(false) @map("auto_closed")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user  User? @relation(fields: [closedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attendees DailyReportAttendance[]

  /// El compuesto (store_id, date) creado por @@unique cubre tanto el lookup
  /// del dashboard ("WHERE storeId = ? AND date BETWEEN ?") como el ordering
  /// por fecha (btree es bidireccional en Postgres). Por eso NO declaramos un
  /// @@index([date]) standalone — sería redundante y solo serviría queries
  /// cross-sucursal que la constitución no modela.
  @@unique([storeId, date])
  @@map("daily_reports")
}

/// Roster of staff who worked the store on the closed day. Free-text names
/// because helpers may not have a system account (occasional support staff,
/// family member helping out, etc.). `userId` stays as an optional FK in case
/// we later wire it back to real accounts for analytics.
model DailyReportAttendance {
  id            String  @id @default(cuid())
  dailyReportId String  @map("daily_report_id")
  fullName      String  @map("full_name")
  userId        String? @map("user_id")

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([dailyReportId])
  @@index([userId])
  @@map("daily_report_attendance")
}

enum ReturnRequestStatus {
  pending
  approved
  rejected

  @@map("return_request_status")
}

/// A vendedora or encargada requests to return a sold item; admin reviews and approves/rejects.
model ReturnRequest {
  id                String              @id @default(cuid())
  requesterId       String              @map("requester_id")
  storeId           String              @map("store_id")
  status            ReturnRequestStatus @default(pending)

  returnedVariantId   String  @map("returned_variant_id")
  returnedQuantity    Int     @default(1) @map("returned_quantity")

  // WHY: saleDate ties the return to a specific day's record without a hard FK to a Sale.
  saleDate          DateTime @map("sale_date")

  exchangeVariantId String?  @map("exchange_variant_id")

  reason            String   @db.Text

  reviewedBy        String?  @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at")
  rejectionReason   String?  @db.Text @map("rejection_reason")

  appliedReturnMovementId String? @map("applied_return_movement_id")
  appliedSaleMovementId   String? @map("applied_sale_movement_id")

  // WHY: Wave 5 redesign — identify the original sale being changed so admin can
  // replace the SaleItem on approve. Nullable because pre-Wave 5 rows lack them.
  originalSaleId        String?       @map("original_sale_id")
  originalSaleItemId    String?       @map("original_sale_item_id")
  originalClosureDate   DateTime?     @map("original_closure_date") @db.Date
  originalPaymentMethod PaymentMethod? @map("original_payment_method")
  originalSubtotalCents Int?          @map("original_subtotal_cents")

  newPaymentMethod      PaymentMethod? @map("new_payment_method")
  newSubtotalCents      Int?          @map("new_subtotal_cents")

  createdAt DateTime @default(now()) @map("created_at")

  requester       User     @relation("RequesterReturnRequests", fields: [requesterId], references: [id])
  reviewer        User?    @relation("ReviewerReturnRequests", fields: [reviewedBy], references: [id])
  store           Store    @relation(fields: [storeId], references: [id])
  returnedVariant Variant  @relation("ReturnedVariantRequests", fields: [returnedVariantId], references: [id])
  exchangeVariant Variant? @relation("ExchangeVariantRequests", fields: [exchangeVariantId], references: [id])
  originalSale    Sale?    @relation(fields: [originalSaleId], references: [id])

  @@index([storeId, status])
  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([originalSaleId])
  @@map("return_requests")
}

enum DeliveryEditRequestStatus {
  pending
  approved
  rejected

  @@map("delivery_edit_request_status")
}

/// A vendedora/encargada requests an edit to a delivery already in `sent` state.
/// Admin reviews; approve only RECORDS the decision — the actual edit happens via
/// the existing PATCH /deliveries/:id/draft flow once the delivery is in draft.
model DeliveryEditRequest {
  id              String                    @id @default(cuid())
  deliveryId      String                    @map("delivery_id")
  requesterId     String                    @map("requester_id")
  reason          String                    @db.Text
  status          DeliveryEditRequestStatus @default(pending)
  reviewedBy      String?                   @map("reviewed_by")
  reviewedAt      DateTime?                 @map("reviewed_at")
  rejectionReason String?                   @db.Text @map("rejection_reason")
  createdAt       DateTime                  @default(now()) @map("created_at")

  delivery  Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  requester User     @relation("RequesterDeliveryEditRequests", fields: [requesterId], references: [id])
  reviewer  User?    @relation("ReviewerDeliveryEditRequests", fields: [reviewedBy], references: [id])

  @@index([deliveryId, status])
  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@map("delivery_edit_requests")
}

/// Point-in-time capture of stock_by_site. Written weekly by the snapshot
/// cron (Sundays 03:00 Bolivia time) and on-demand via POST /api/v1/inventory-snapshots.
/// Used for historical reports and bank-loan evidence.
/// capturedAt is the logical timestamp of the snapshot run — all rows in the
/// same batch share the same capturedAt value set at the start of the job.
model InventorySnapshot {
  id         String   @id @default(cuid())
  storeId    String   @map("store_id")
  variantId  String   @map("variant_id")
  quantity   Int
  capturedAt DateTime @map("captured_at")
  createdAt  DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Prevents double-capture within the same batch for the same (store, variant, timestamp).
  @@unique([storeId, variantId, capturedAt], name: "inventory_snapshots_store_variant_captured_at_unique")
  @@index([storeId, capturedAt(sort: Desc)])
  @@index([capturedAt])
  @@map("inventory_snapshots")
}
